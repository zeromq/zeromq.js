 void zmq::thread_t::stop ()
 {
     if (_started) {
+#if defined __EMSCRIPTEN__
+        _started = false;
+#else
         int rc = pthread_join (_descriptor, NULL);
         posix_assert (rc);
+#endif
     }
 }
 
 bool zmq::thread_t::is_current_thread () const
 {
+#if defined __EMSCRIPTEN__
+    return _started;
+#else
     return bool (pthread_equal (pthread_self (), _descriptor));
+#endif
 }
 
