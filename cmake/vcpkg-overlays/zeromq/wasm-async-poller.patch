+/* SPDX-License-Identifier: MPL-2.0 */
+
+#ifndef __ZMQ_POLLER_WASM_HPP_INCLUDED__
+#define __ZMQ_POLLER_WASM_HPP_INCLUDED__
+
+/* The Node napi-wasm adapter supplies these callbacks. They keep libzmq's
+   worker pollers cooperative when Emscripten pthreads are unavailable. */
+extern "C" {
+void napi_wasm_schedule (void (*callback_) (void *), void *arg_, int delay_);
+void napi_wasm_cancel (void *arg_);
+}
+
+namespace zmq
+{
+inline void schedule_wasm_worker (void (*callback_) (void *),
+                                  void *arg_,
+                                  int delay_)
+{
+    napi_wasm_schedule (callback_, arg_, delay_);
+}
+
+inline void cancel_wasm_worker (void *arg_)
+{
+    napi_wasm_cancel (arg_);
+}
+}
+
+#endif
